{
  "name": "xiaochao-bawang",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @xiaochao/web --filter @xiaochao/server dev",
    "build": "pnpm --filter @xiaochao/web build",
    "start": "pnpm --filter @xiaochao/server start",
    "test": "pnpm --filter @xiaochao/server test --maxWorkers=4 --minWorkers=1 && pnpm test:web",
    "test:web": "node --test --test-concurrency=4 apps/web/src/*.test.js apps/web/src/keyboard/*.test.js apps/web/src/runtime/*.test.js runtime/j2me/*.test.mjs",
    "typecheck": "pnpm --filter @xiaochao/server typecheck",
    "pack": "./pack-site.sh",
    "mobile:prepare-web": "pnpm --filter @xiaochao/mobile prepare-web",
    "mobile:build-android": "pnpm --filter @xiaochao/mobile build-android-release",
    "mobile:typecheck": "pnpm --filter @xiaochao/mobile typecheck",
    "mobile:verify-web": "pnpm --filter @xiaochao/mobile verify-web-assets"
  }
}
