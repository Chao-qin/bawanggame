# Release signing configuration — copy this file to keystore.properties
# (gitignored) and fill in your own values. Alternatively, set the
# RELEASE_KEYSTORE_FILE / RELEASE_KEYSTORE_PASSWORD / RELEASE_KEY_ALIAS /
# RELEASE_KEY_PASSWORD environment variables; they take effect when
# keystore.properties is absent.
#
# Keep the .keystore file and this file OUTSIDE the repository, and back
# them up: losing the keystore means losing the ability to ship updates
# to installed apps.
storeFile=/absolute/path/to/your-release.keystore
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
