# Copy to .env and fill in. .env is ignored by Git; never commit the real secret.
# Docker Compose reads .env from the project root. A direct Node run must load it explicitly:
#   node --env-file=.env apps/server/dist/src/main.js
# Workbook and sheet IDs for each environment are listed in docs/reporting.md.

# Compose port binding
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Environment label written into every record
LOG_ENV=production
# Direct Node runs only: writable queue directory (Compose fixes it to /app/.data/reporting)
# LOG_DIR=.data/reporting

# Feishu Sheets sync; leave any value empty to keep logs on the console and local queue only
FEISHU_APP_ID=cli_ab82e4f599b85cf3
FEISHU_APP_SECRET=
FEISHU_SPREADSHEET_TOKEN=AcNrsmuLBhaZ0ytUq4McDpixnpe
FEISHU_USAGE_SHEET_ID=2d1e23
FEISHU_ERROR_SHEET_ID=UywsXp
FEISHU_SERVER_SHEET_ID=iOypFx
# Optional 会话 sheet (one row per app session and per play, updated in place); empty keeps session state local
FEISHU_SESSION_SHEET_ID=
